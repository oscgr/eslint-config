{
  "name": "@oscgr/eslint-config",
  "type": "module",
  "version": "1.0.0",
  "description": "Personal ESLint config",
  "exports": "./index.js",
  "repository": "https://github.com/oscgr/eslint-config.git",
  "files": [
    "index.js"
  ],
  "scripts": {
    "preinstall": "pnpx only-allow pnpm",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate-licences": "pnpm licenses ls --prod --long > LICENCES.txt",
    "publish": "pnpm publish --no-git-checks"
  },
  "peerDependencies": {
    "eslint": ">=10.0.0"
  },
  "dependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@eslint/eslintrc": "^3.3.5"
  },
  "devDependencies": {
    "eslint": "^10.6.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
